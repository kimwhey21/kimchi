.env
__pycache__/
*.pyc
output/
# 디렉터리째(`state/`) 막으면 git이 안으로 들어가지 않아 아래 예외가 안 먹습니다.
state/*
# 워드프레스 플러그인 정리 전 목록(되돌릴 때 쓰는 기록)만 예외로 추적합니다.
# state/의 나머지(history_*.json)는 매일 바뀌는 실행 상태라 계속 무시합니다.
!state/plugins_before_cleanup_*.json
# 맥 작업 신호(scripts/mac_beats.py, 2026-10-05) — 증명서가 읽는다
!state/mac_beats.json
# 증명서가 전날 경고를 기억하는 파일(2026-10-06) — 반복 경고에 'N일째'를 붙인다
!state/proof_issues.json
.DS_Store
.claude/

# 구글 서비스 계정 비밀키 (절대 커밋 금지)
*service-account*.json
*-seo-reader-*.json
.google-service-account.json
# 시험 덮음률 측정 결과(로컬)
.coverage
