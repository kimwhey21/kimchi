<!DOCTYPE html>
<html lang="{{ lang or 'ko' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css">
<style>
  :root {
    --mb-up: #e34948;
    --mb-down: #2a78d6;
    --mb-bg: #fafaf9;
    --mb-card: #ffffff;
    --mb-border: #e5e3dd;
    --mb-text: #17171a;
    --mb-text-muted: #6b6a66;
  }
  * { box-sizing: border-box; }
  body {
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--mb-bg);
    color: var(--mb-text);
    max-width: 720px;
    margin: 0 auto;
    padding: 32px 20px 80px;
    line-height: 1.7;
  }
  .mb-eyebrow { font-size: 13px; color: var(--mb-text-muted); letter-spacing: .02em; margin-bottom: 8px; }
  h1 { font-size: 26px; font-weight: 700; line-height: 1.4; margin: 0 0 28px; }
  h2 { font-size: 19px; font-weight: 700; margin: 40px 0 12px; }
  h3 { font-size: 16px; font-weight: 700; margin: 20px 0 8px; }
  p { margin: 0 0 14px; font-size: 16px; }
  .mb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; margin: 20px 0; }
  .mb-card { background: var(--mb-card); border: 1px solid var(--mb-border); border-radius: 12px; padding: 16px; min-width: 0; overflow: hidden; }
  .mb-card .mb-label { font-size: 13px; color: var(--mb-text-muted); margin-bottom: 4px; overflow-wrap: break-word; }
  .mb-card .mb-label .mb-ticker { color: var(--mb-text-muted); opacity: .7; font-size: 12px; }
  .mb-card .mb-sub-label { font-size: 12px; color: var(--mb-text-muted); opacity: .8; overflow-wrap: break-word; }
  .mb-card .mb-price { font-size: 20px; font-weight: 700; overflow-wrap: break-word; }
  .mb-card .mb-delta { font-size: 13px; font-weight: 600; margin: 2px 0 8px; }
  .mb-card .mb-delta.mb-up { color: var(--mb-up); }
  .mb-card .mb-delta.mb-down { color: var(--mb-down); }
  .mb-cal-item { display: flex; gap: 12px; padding: 12px; border: 1px solid var(--mb-border); border-radius: 10px; margin-bottom: 8px; background: var(--mb-card); }
  .mb-cal-date { min-width: 66px; font-size: 13px; color: var(--mb-text-muted); flex-shrink: 0; }
  .mb-cal-title { font-weight: 600; font-size: 14px; margin: 0 0 2px; }
  .mb-cal-desc { font-size: 13px; color: var(--mb-text-muted); margin: 0; }
  .mb-closing { margin-top: 36px; padding-top: 24px; border-top: 1px dashed var(--mb-border); text-align: center; }
  .mb-closing h2 { margin-top: 0; font-size: 23px; }
  .mb-closing p { font-style: italic; color: #333230; text-align: left; }
  .mb-table-wrap { overflow-x: auto; margin: 20px 0; }
  table.mb-data-table { width: 100%; min-width: 320px; border-collapse: collapse; margin: 0; }
  .mb-data-table th, .mb-data-table td { padding: 10px 12px; text-align: right; border-bottom: 1px solid var(--mb-border); font-size: 14px; }
  .mb-data-table th:first-child, .mb-data-table td:first-child { text-align: left; }
  .mb-data-table thead th { color: var(--mb-text-muted); font-weight: 600; font-size: 12px; }
  .mb-data-table td.mb-up { color: var(--mb-up); font-weight: 600; }
  .mb-data-table td.mb-down { color: var(--mb-down); font-weight: 600; }
  .mb-chart-wrap { position: relative; width: 100%; margin: 20px 0; }
  .mb-story-head { display: flex; align-items: center; gap: 10px; margin: 28px 0 8px; }
  .mb-story-icon { flex-shrink: 0; width: 34px; height: 34px; border-radius: 9px; background: var(--mb-card); border: 1px solid var(--mb-border); display: flex; align-items: center; justify-content: center; color: var(--mb-text-muted); }
  .mb-story-icon svg { width: 19px; height: 19px; }
  .mb-story-head h3 { margin: 0; }
  .mb-story-photo { width: 100%; height: auto; border-radius: 12px; margin: 14px 0 4px; display: block; }
  .mb-photo-credit { font-size: 11px; color: var(--mb-text-muted); margin: 0 0 14px; }
  .mb-photo-credit a { color: var(--mb-text-muted); }
  .mb-stat-compare { display: flex; align-items: center; gap: 14px; margin: 18px 0; padding: 18px; background: var(--mb-card); border: 1px solid var(--mb-border); border-radius: 12px; }
  .mb-stat-compare .mb-stat-block { flex: 1; text-align: center; }
  .mb-stat-compare .mb-stat-label { font-size: 12px; color: var(--mb-text-muted); margin-bottom: 4px; }
  .mb-stat-compare .mb-stat-value { font-size: 24px; font-weight: 700; }
  .mb-stat-compare .mb-stat-arrow { flex-shrink: 0; text-align: center; color: var(--mb-text-muted); }
  .mb-stat-compare .mb-stat-multiple { display: block; margin-top: 2px; font-size: 13px; font-weight: 700; color: var(--mb-up); }
  footer { margin-top: 48px; font-size: 12px; color: var(--mb-text-muted); border-top: 1px solid var(--mb-border); padding-top: 16px; }

  @media (max-width: 480px) {
    body { padding: 24px 14px 60px; }
    h1 { font-size: 22px; }
    .mb-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); }
    .mb-stat-compare { flex-wrap: wrap; justify-content: center; padding: 14px; gap: 10px 6px; }
    .mb-stat-compare .mb-stat-block { flex: 1 1 80px; min-width: 80px; }
    .mb-stat-compare .mb-stat-value { font-size: 20px; }
  }
</style>
</head>
<body>
  <div class="mb-eyebrow">{{ market_label }}{{ "" if lang == "en" else " 마감 시황" }} · {{ date_str }}</div>
  <h1>{{ title }}</h1>

  <div class="mb-grid">
    {% for c in macro_cards %}
    <div class="mb-card">
      <div class="mb-label">{{ c.name }}</div>
      <div class="mb-price">{{ c.price }}</div>
      <div class="mb-delta mb-{{ c.direction }}">{{ c.change_label }}</div>
    </div>
    {% endfor %}
  </div>

  {% for section in narrative %}
  <h2>{{ section.heading }}</h2>
  {% for para in section.body.split('\n\n') %}
  <p>{{ para }}</p>
  {% endfor %}
  {% endfor %}

  {% if theme_cards %}
  <h2>{{ theme_heading }}</h2>
  <div class="mb-grid">
    {% for c in theme_cards %}
    <div class="mb-card">
      <div class="mb-label">{{ c.label }}</div>
      <div class="mb-sub-label">{{ c.sub_label }}</div>
      <div class="mb-delta mb-{{ c.direction }}" style="font-size:18px; margin-top:2px;">{{ c.change_label }}</div>
    </div>
    {% endfor %}
  </div>
  {% if theme_commentary %}<p>{{ theme_commentary }}</p>{% endif %}
  {% endif %}

  {% if stock_cards %}
  <h2>{{ stock_heading }}</h2>
  <div class="mb-grid">
    {% for c in stock_cards %}
    <div class="mb-card">
      <div class="mb-label">{{ c.name }}{% if c.ticker %} <span class="mb-ticker">({{ c.ticker }})</span>{% endif %}</div>
      <div class="mb-delta mb-{{ c.direction }}" style="font-size:18px; margin-top:2px;">{{ c.change_label }}</div>
    </div>
    {% endfor %}
  </div>
  {% if stock_commentary %}<p>{{ stock_commentary }}</p>{% endif %}
  {% endif %}

  {% if outlook %}
  <h2>{{ outlook.heading }}</h2>
  <p>{{ outlook.body }}</p>
  {% endif %}

  {% if insight_section %}
  <h2>{{ insight_section.heading }}</h2>
  {% for item in insight_section.stories %}
  <div class="mb-story-head">
    <span class="mb-story-icon"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">{{ item.icon_svg|safe }}</svg></span>
    <h3>{{ item.heading }}</h3>
  </div>
  {% if item.image %}
  <img class="mb-story-photo" src="{{ item.image.url }}" alt="{{ item.image.alt or item.heading }}" loading="lazy">
  <p class="mb-photo-credit">사진: <a href="{{ item.image.photographer_url }}" target="_blank" rel="noopener">{{ item.image.photographer }}</a> / Unsplash</p>
  {% endif %}
  {% for para in item.body.split('\n\n') %}
  <p>{{ para }}</p>
  {% endfor %}
  {% if item.chart and item.chart.type == 'stat' %}
  <div class="mb-stat-compare">
    {% for label in item.chart.labels %}
    <div class="mb-stat-block">
      <div class="mb-stat-label">{{ label }}</div>
      <div class="mb-stat-value">{{ item.chart.data[loop.index0] }}{{ item.chart.unit }}</div>
    </div>
    {% if not loop.last %}
    <div class="mb-stat-arrow">→<span class="mb-stat-multiple">{{ item.chart.multiples[loop.index0] }}</span></div>
    {% endif %}
    {% endfor %}
  </div>
  {% elif item.chart %}
  <div class="mb-chart-wrap" style="height: 220px;">
    <canvas id="insightChart{{ loop.index }}" role="img" aria-label="{{ item.chart.title }}">{{ item.chart.title }}</canvas>
  </div>
  {% elif item.table %}
  <div class="mb-table-wrap">
    <table class="mb-data-table">
      <tbody>
        {% for row in item.table %}
        <tr><td>{{ row.label }}</td><td>{{ row.value }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  {% endfor %}
  {% endif %}

  {% if calendar %}
  <h2>{{ "Upcoming Events" if lang == "en" else "다음 주 주목할 일정" }}</h2>
  {% for ev in calendar %}
  <div class="mb-cal-item">
    <div class="mb-cal-date">{{ ev.date }}</div>
    <div>
      <p class="mb-cal-title">{{ ev.title }}</p>
      <p class="mb-cal-desc">{{ ev.desc }}</p>
    </div>
  </div>
  {% endfor %}
  {% endif %}

  {% if closing %}
  <div class="mb-closing">
    <h2>{{ closing.heading }}</h2>
    {% for para in closing.body.split('\n\n') %}
    <p>{{ para }}</p>
    {% endfor %}
  </div>
  {% endif %}

  <footer>{{ "For informational purposes only. Not investment advice." if lang == "en" else "투자 참고용이며 투자 권유가 아닙니다." }}</footer>

{% set has_insight_charts = insight_section and (insight_section.stories|selectattr('chart')|list) %}
{% if has_insight_charts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
{% for item in insight_section.stories %}
{% if item.chart and item.chart.type != 'stat' %}
new Chart(document.getElementById('insightChart{{ loop.index }}'), {
  type: {{ item.chart.type|tojson }},
  data: {
    labels: {{ item.chart.labels|tojson }},
    datasets: [{
      label: {{ (item.chart.unit or '')|tojson }},
      data: {{ item.chart.data|tojson }},
      backgroundColor: 'rgba(42,120,214,0.75)',
      borderColor: '#2a78d6',
      borderRadius: 4,
      tension: 0.3,
      fill: false
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: {
      legend: { display: false },
      title: { display: true, text: {{ item.chart.title|tojson }}, color: '#17171a', font: { size: 13, weight: '600' }, padding: { bottom: 10 } }
    },
    scales: {
      y: { grid: { color: '#e5e3dd' }, ticks: { callback: v => v + ({{ (item.chart.unit or '')|tojson }} || '') } },
      x: { grid: { display: false } }
    }
  }
});
{% endif %}
{% endfor %}
{% endif %}
</script>
</body>
</html>
