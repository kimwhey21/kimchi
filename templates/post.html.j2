<!DOCTYPE html>
<html lang="{{ lang or 'ko' }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{% if meta_description %}
<meta name="description" content="{{ meta_description }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ meta_description }}">
<meta property="og:type" content="article">
<meta property="og:locale" content="{{ 'en_US' if lang == 'en' else 'ko_KR' }}">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ meta_description }}">
{% endif %}
{% include "_styles.html.j2" %}
</head>
<body>
  <div class="mb-eyebrow">{{ market_label }}{{ "" if lang == "en" else " 마감 시황" }} · {{ date_str }}</div>
  <h1>{{ title }}</h1>

  {% if macro_cards %}
  <div class="mb-grid">
    {% for c in macro_cards %}
    <div class="mb-card">
      <div class="mb-label">{{ c.name }}</div>
      {% if c.as_of %}<div class="mb-sub-label">{{ c.as_of }}</div>{% endif %}
      <div class="mb-price">{{ c.price }}</div>
      <div class="mb-delta mb-{{ c.direction }}">{{ c.change_label }}</div>
    </div>
    {% endfor %}
  </div>
  {% endif %}

  {% if foreign_flow_rows %}
  <h2>{{ "Today's Foreign Investor Flows" if lang == "en" else "오늘의 외국인 매매동향" }}</h2>
  <div class="mb-table-wrap">
    <table class="mb-data-table">
      <thead>
        <tr>
          <th>{{ "Stock" if lang == "en" else "종목" }}</th>
          <th>{{ "Foreign net (shares)" if lang == "en" else "외국인 순매매(주)" }}</th>
          <th>{{ "Foreign ownership" if lang == "en" else "외국인 보유율" }}</th>
        </tr>
      </thead>
      <tbody>
        {% for row in foreign_flow_rows %}
        <tr>
          <td>{{ row.name }}</td>
          <td class="mb-{{ row.direction }}">{{ "{:+,}".format(row.foreign_net) }}</td>
          <td>{{ row.foreign_ratio }}%</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  {% for section in narrative %}
  <h2>{{ section.heading }}</h2>
  {% for para in section.body.split('\n\n') %}
  <p>{{ para|safe }}</p>
  {% endfor %}
  {% if section.graphic %}
  <img class="mb-figure" src="{{ section.graphic.url }}" alt="{{ section.graphic.alt }}" loading="lazy">
  {% endif %}
  {% endfor %}

  {% if theme_cards %}
  <h2>{{ theme_heading }}</h2>
  <div class="mb-grid">
    {% for c in theme_cards %}
    <div class="mb-card">
      <div class="mb-label">{{ c.label }}</div>
      <div class="mb-sub-label">{{ c.sub_label }}</div>
      <div class="mb-delta mb-{{ c.direction }}" style="font-size:18px; margin-top:2px;">{{ c.change_label }}</div>
    </div>
    {% endfor %}
  </div>
  {% if theme_commentary %}<p>{{ theme_commentary }}</p>{% endif %}
  {% endif %}

  {% if stock_cards %}
  <h2>{{ stock_heading }}</h2>
  <div class="mb-grid">
    {% for c in stock_cards %}
    <div class="mb-card">
      <div class="mb-label">{{ c.name }}{% if c.ticker %} <span class="mb-ticker">({{ c.ticker }})</span>{% endif %}</div>
      <div class="mb-delta mb-{{ c.direction }}" style="font-size:18px; margin-top:2px;">{{ c.change_label }}</div>
    </div>
    {% endfor %}
  </div>
  {% if stock_commentary %}<p>{{ stock_commentary }}</p>{% endif %}
  {% endif %}

  {% if outlook %}
  <h2>{{ outlook.heading }}</h2>
  {% for para in outlook.body.split('\n\n') %}
  <p>{{ para|safe }}</p>
  {% endfor %}
  {% endif %}

  {% if insight_section %}
  <h2>{{ insight_section.heading }}</h2>
  {% for item in insight_section.stories %}
  <div class="mb-story-head">
    <span class="mb-story-icon"><svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">{{ item.icon_svg|safe }}</svg></span>
    <h3>{{ item.heading }}</h3>
  </div>
  {% if item.image %}
  <img class="mb-story-photo" src="{{ item.image.url }}" alt="{{ item.image.alt or item.heading }}"{% if item.image.width and item.image.height %} width="{{ item.image.width }}" height="{{ item.image.height }}"{% endif %} loading="lazy">
  {% if item.image.credit %}
  <p class="mb-photo-credit">{% if item.image.credit_url %}<a href="{{ item.image.credit_url }}" target="_blank" rel="noopener">{{ item.image.credit }}</a>{% else %}{{ item.image.credit }}{% endif %}</p>
  {% elif item.image.photographer and item.image.photographer_url %}
  <p class="mb-photo-credit">{{ "Photo" if lang == "en" else "사진" }}: <a href="{{ item.image.photographer_url }}" target="_blank" rel="noopener">{{ item.image.photographer }}</a> / Unsplash</p>
  {% endif %}
  {% endif %}
  {% for para in item.body.split('\n\n') %}
  <p>{{ para|safe }}</p>
  {% endfor %}
  {% if item.chart and item.chart.type == 'stat' %}
  <div class="mb-stat-compare">
    {% for label in item.chart.labels %}
    <div class="mb-stat-block">
      <div class="mb-stat-label">{{ label }}</div>
      <div class="mb-stat-value">{{ item.chart.data[loop.index0] }}{{ item.chart.unit }}</div>
    </div>
    {% if not loop.last %}
    <div class="mb-stat-arrow">→<span class="mb-stat-multiple">{{ item.chart.multiples[loop.index0] }}</span></div>
    {% endif %}
    {% endfor %}
  </div>
  {% elif item.chart %}
  <div class="mb-chart-wrap" style="height: 220px;">
    <canvas id="insightChart{{ loop.index }}" role="img" aria-label="{{ item.chart.title }}">{{ item.chart.title }}</canvas>
  </div>
  {% elif item.table %}
  <div class="mb-table-wrap">
    <table class="mb-data-table">
      <tbody>
        {% for row in item.table %}
        <tr><td>{{ row.label }}</td><td>{{ row.value }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
  {% endfor %}
  {% endif %}

  {% if calendar %}
  <h2>{{ "Upcoming Events" if lang == "en" else "다음 주 주목할 일정" }}</h2>
  {% for ev in calendar %}
  <div class="mb-cal-item">
    <div class="mb-cal-date">{{ ev.date }}</div>
    <div>
      <p class="mb-cal-title">{{ ev.title }}</p>
      <p class="mb-cal-desc">{{ ev.desc }}</p>
    </div>
  </div>
  {% endfor %}
  {% endif %}

  {% if closing %}
  <div class="mb-closing">
    <h2>{{ closing.heading }}</h2>
    {% for para in closing.body.split('\n\n') %}
    <p>{{ para|safe }}</p>
    {% endfor %}
  </div>
  {% endif %}

  {% if source_notes %}
  <section class="mb-sources" aria-label="{{ 'Sources' if lang == 'en' else '자료 출처' }}">
    <h2>{{ "Sources" if lang == "en" else "자료 확인" }}</h2>
    <ul class="mb-source-list">
      {% for source in source_notes %}
      <li class="mb-source-item">
        <span class="mb-source-name">{{ source.name }}</span>
        <a href="{{ source.url }}" target="_blank" rel="noopener">{{ source.title }}</a>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endif %}

  {% if subscribe_form_action %}
  <div class="mb-subscribe">
    <h2>{{ "Get this in your inbox" if lang == "en" else "매일 아침 이메일로 받아보기" }}</h2>
    <p>{{ "The daily Korea/US market brief for foreign investors, delivered free." if lang == "en" else "오늘 같은 시황 브리핑을 매일 아침 이메일로 무료로 받아보세요." }}</p>
    <form action="{{ subscribe_form_action }}" method="post" target="_blank" class="mb-subscribe-form">
      <input type="email" name="email" placeholder="{{ 'you@example.com' if lang == 'en' else '이메일 주소' }}" required>
      <button type="submit">{{ "Subscribe" if lang == "en" else "구독하기" }}</button>
    </form>
  </div>
  {% endif %}

  <footer>{{ "For informational purposes only. Not investment advice." if lang == "en" else "투자 참고용이며 투자 권유가 아닙니다." }}</footer>

{% set has_insight_charts = insight_section and (insight_section.stories|selectattr('chart')|list) %}
{% if has_insight_charts %}
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>
<script>
{% for item in insight_section.stories %}
{% if item.chart and item.chart.type != 'stat' %}
new Chart(document.getElementById('insightChart{{ loop.index }}'), {
  type: {{ item.chart.type|tojson }},
  data: {
    labels: {{ item.chart.labels|tojson }},
    datasets: [{
      label: {{ (item.chart.unit or '')|tojson }},
      data: {{ item.chart.data|tojson }},
      backgroundColor: 'rgba(42,120,214,0.75)',
      borderColor: '#2a78d6',
      borderRadius: 4,
      tension: 0.3,
      fill: false
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: {
      legend: { display: false },
      title: { display: true, text: {{ item.chart.title|tojson }}, color: '#17171a', font: { size: 13, weight: '600' }, padding: { bottom: 10 } }
    },
    scales: {
      y: { grid: { color: '#e5e3dd' }, ticks: { callback: v => v + ({{ (item.chart.unit or '')|tojson }} || '') } },
      x: { grid: { display: false } }
    }
  }
});
{% endif %}
{% endfor %}
</script>
{% endif %}
</body>
</html>
