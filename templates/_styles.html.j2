{# 시황과 가이드가 함께 쓰는 스타일입니다. 복사해 두면 한쪽만 바뀌어
   '완전히 다른 사람이 쓴 글'처럼 보입니다 — 2026-09-06에 실제로 그랬습니다. #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/static/pretendard.css">
<style>
  :root {
    --mb-up: #e34948;
    --mb-down: #2a78d6;
    --mb-bg: #fafaf9;
    --mb-card: #ffffff;
    --mb-border: #e5e3dd;
    --mb-text: #17171a;
    --mb-text-muted: #6b6a66;
  }
  * { box-sizing: border-box; }
  body {
    font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif;
    background: var(--mb-bg);
    color: var(--mb-text);
    width: 100%;
    max-width: 760px;
    margin: 0 auto;
    padding: 32px 20px 80px;
    line-height: 1.78;
    word-break: normal;
    line-break: strict;
    overflow-x: hidden;
  }
  .mb-eyebrow { width: 100%; font-size: 13px; color: var(--mb-text-muted); letter-spacing: .02em; margin-bottom: 8px; }
  h1, h2, h3 { max-width: 100%; font-family: 'Pretendard', -apple-system, BlinkMacSystemFont, sans-serif; letter-spacing: normal; word-break: keep-all; overflow-wrap: break-word; }
  h1 { font-size: 26px; font-weight: 700; line-height: 1.4; margin: 0 0 28px; }
  h2 { font-size: 19px; font-weight: 700; margin: 40px 0 12px; }
  h3 { font-size: 16px; font-weight: 700; margin: 20px 0 8px; }
  p { width: 100%; max-width: none; margin: 0 0 16px; font-size: 16px; text-align: justify; text-justify: inter-character; text-wrap: wrap; word-break: normal; line-break: strict; overflow-wrap: break-word; }
  .mb-grid { width: 100%; display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; margin: 20px 0; }
  .mb-card { background: var(--mb-card); border: 1px solid var(--mb-border); border-radius: 12px; padding: 16px; min-width: 0; overflow: hidden; }
  .mb-card .mb-label { font-size: 13px; color: var(--mb-text-muted); margin-bottom: 4px; overflow-wrap: break-word; }
  .mb-card .mb-label .mb-ticker { color: var(--mb-text-muted); opacity: .7; font-size: 12px; }
  .mb-card .mb-sub-label { font-size: 12px; color: var(--mb-text-muted); opacity: .8; overflow-wrap: break-word; }
  .mb-card .mb-price { font-size: 20px; font-weight: 700; overflow-wrap: break-word; }
  .mb-card .mb-delta { font-size: 13px; font-weight: 600; margin: 2px 0 8px; }
  .mb-card .mb-delta.mb-up { color: var(--mb-up); }
  .mb-card .mb-delta.mb-down { color: var(--mb-down); }
  .mb-cal-item { display: flex; gap: 12px; padding: 12px; border: 1px solid var(--mb-border); border-radius: 10px; margin-bottom: 8px; background: var(--mb-card); }
  .mb-cal-date { min-width: 66px; font-size: 13px; color: var(--mb-text-muted); flex-shrink: 0; }
  .mb-cal-title { font-weight: 600; font-size: 14px; margin: 0 0 2px; }
  .mb-cal-desc { font-size: 13px; color: var(--mb-text-muted); margin: 0; }
  .mb-closing { margin-top: 36px; padding-top: 24px; border-top: 1px dashed var(--mb-border); text-align: center; }
  /* 사이트 로고(홈 버튼)와 같은 서체로 맞춘 브랜드 표식입니다.
     Beiruti는 테마가 전역으로 싣고 있어 글 페이지에서도 그대로 쓸 수 있습니다
     (2026-09-04 확인: document.fonts.check("600 40px Beiruti") === true).
     크기는 로고보다 작게 둡니다 — 같은 크기로 두면 글 중간에 사이트 제목이
     한 번 더 나온 것처럼 보입니다. */
  .mb-closing h2 { margin-top: 0; font-family: 'Beiruti', 'Pretendard', sans-serif;
    font-size: 19px; font-weight: 600; text-transform: uppercase; letter-spacing: 2.4px;
    color: var(--mb-text-muted); }
  .mb-closing p { font-style: italic; color: #333230; text-align: left; }
  .mb-subscribe { margin-top: 32px; padding: 24px; background: var(--mb-card); border: 1px solid var(--mb-border); border-radius: 14px; text-align: center; }
  .mb-subscribe h2 { margin-top: 0; font-size: 19px; }
  .mb-subscribe p { color: var(--mb-text-muted); font-size: 14px; }
  .mb-subscribe-form { display: flex; gap: 8px; max-width: 380px; margin: 16px auto 0; }
  .mb-subscribe-form input[type="email"] { flex: 1; min-width: 0; padding: 10px 12px; border: 1px solid var(--mb-border); border-radius: 8px; font-size: 14px; }
  .mb-subscribe-form button { flex-shrink: 0; padding: 10px 16px; border: none; border-radius: 8px; background: var(--mb-text); color: #fff; font-size: 14px; font-weight: 600; cursor: pointer; }
  .mb-table-wrap { width: 100%; max-width: 100%; overflow-x: auto; margin: 20px 0; }
  table.mb-data-table { width: 100%; min-width: 320px; border-collapse: collapse; margin: 0; }
  .mb-data-table th, .mb-data-table td { padding: 10px 12px; text-align: right; border-bottom: 1px solid var(--mb-border); font-size: 14px; }
  .mb-data-table th:first-child, .mb-data-table td:first-child { text-align: left; }
  .mb-data-table thead th { color: var(--mb-text-muted); font-weight: 600; font-size: 12px; }
  .mb-data-table td.mb-up { color: var(--mb-up); font-weight: 600; }
  .mb-data-table td.mb-down { color: var(--mb-down); font-weight: 600; }
  .mb-chart-wrap { position: relative; width: 100%; margin: 20px 0; }
  .mb-story-head { display: flex; align-items: center; gap: 10px; margin: 28px 0 8px; }
  .mb-story-icon { flex-shrink: 0; width: 34px; height: 34px; border-radius: 9px; background: var(--mb-card); border: 1px solid var(--mb-border); display: flex; align-items: center; justify-content: center; color: var(--mb-text-muted); }
  .mb-story-icon svg { width: 19px; height: 19px; }
  .mb-story-head h3 { margin: 0; }
  .mb-story-photo { width: 100%; max-width: 100%; height: auto; border-radius: 12px; margin: 14px 0 4px; display: block; }
  .mb-photo-credit { font-size: 11px; color: var(--mb-text-muted); margin: 0 0 14px; }
  /* 본문 사이에 들어가는 데이터 그래픽. 그날 시세로 그린 것이라 사진과 달리
     출처 표기가 필요 없습니다. */
  .mb-figure { width: 100%; max-width: 100%; height: auto; border-radius: 12px; margin: 20px 0; display: block; border: 1px solid var(--mb-border); }
  .mb-photo-credit, .mb-card p, .mb-cal-item p, .mb-subscribe p { text-align: left; }
  .mb-photo-credit a { color: var(--mb-text-muted); }
  .mb-stat-compare { display: flex; align-items: center; gap: 14px; margin: 18px 0; padding: 18px; background: var(--mb-card); border: 1px solid var(--mb-border); border-radius: 12px; }
  .mb-stat-compare .mb-stat-block { flex: 1; text-align: center; }
  .mb-stat-compare .mb-stat-label { font-size: 12px; color: var(--mb-text-muted); margin-bottom: 4px; }
  .mb-stat-compare .mb-stat-value { font-size: 24px; font-weight: 700; }
  .mb-stat-compare .mb-stat-arrow { flex-shrink: 0; text-align: center; color: var(--mb-text-muted); }
  .mb-stat-compare .mb-stat-multiple { display: block; margin-top: 2px; font-size: 13px; font-weight: 700; color: var(--mb-up); }
  .mb-sources { width: 100%; margin-top: 42px; padding-top: 22px; border-top: 1px solid var(--mb-border); }
  .mb-sources h2 { margin: 0 0 12px; font-size: 17px; }
  .mb-source-list { list-style: none; margin: 0; padding: 0; }
  .mb-source-item { display: grid; grid-template-columns: minmax(80px, 110px) minmax(0, 1fr); gap: 12px; padding: 10px 0; border-bottom: 1px solid var(--mb-border); }
  .mb-source-name { color: var(--mb-text-muted); font-size: 12px; font-weight: 700; }
  .mb-source-item a { min-width: 0; color: var(--mb-text); font-size: 13px; line-height: 1.55; text-decoration-thickness: 1px; text-underline-offset: 2px; overflow-wrap: break-word; }
  footer { margin-top: 48px; font-size: 12px; color: var(--mb-text-muted); border-top: 1px solid var(--mb-border); padding-top: 16px; }

  @media (max-width: 480px) {
    body { padding: 24px 14px 60px; }
    h1 { font-size: 22px; }
    .mb-grid { grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); }
    .mb-stat-compare { flex-wrap: wrap; justify-content: center; padding: 14px; gap: 10px 6px; }
    .mb-stat-compare .mb-stat-block { flex: 1 1 80px; min-width: 80px; }
    .mb-stat-compare .mb-stat-value { font-size: 20px; }
    p { text-align: left; }
    .mb-source-item { grid-template-columns: 1fr; gap: 3px; }
  }
</style>
