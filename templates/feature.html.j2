<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{% if meta_description %}
<meta name="description" content="{{ meta_description }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ meta_description }}">
<meta property="og:type" content="article">
<meta property="og:locale" content="ko_KR">
{% endif %}
{% include "_styles.html.j2" %}
<style>
  .mb-figure { margin: 28px 0; }
  .mb-figure img { width: 100%; height: auto; border-radius: 6px; display: block; }
  .mb-figure figcaption { font-size: 13px; color: var(--mb-text-muted); margin-top: 8px; }
</style>
</head>
<body>
  <div class="mb-eyebrow">{{ kicker }}</div>
  <h1>{{ title }}</h1>

  {% for section in sections %}
  <h2>{{ section.heading }}</h2>
  {% if section.figure %}
  <figure class="mb-figure">
    <img src="{{ section.figure.url }}" alt="{{ section.figure.alt }}" loading="lazy">
    <figcaption>{{ section.figure.alt }}</figcaption>
  </figure>
  {% endif %}
  {% for para in section.paragraphs %}<p>{{ para|safe }}</p>
  {% endfor %}
  {% endfor %}

  <div class="mb-closing">
    <h2>{{ closing.heading }}</h2>
    {% for para in closing.paragraphs %}<p>{{ para|safe }}</p>
    {% endfor %}
  </div>

  {% if related %}
  <div class="mb-related">
    <p class="mb-related-label">관련 글</p>
    <ul class="mb-related-list">
      {% for item in related %}<li><a href="{{ item.url }}">{{ item.title }}</a></li>
      {% endfor %}
    </ul>
  </div>
  {% endif %}

  <footer>이 글은 정보 제공을 목적으로 하며 특정 종목의 매수·매도를 권유하지 않습니다.</footer>
</body>
</html>
